source "https://rubygems.org"

# GitHub Pages compatible dependency set ONLY.
# Do NOT add `gem "just-the-docs"` here: combined with the theme it produced
# "The github-pages gem can't satisfy your Gemfile's dependencies" on earlier
# Decnet doc sites. The theme itself is loaded via `remote_theme` in
# _config.yml — that pairing is the proven fix (PERCH-DOC).
gem "github-pages", group: :jekyll_plugins
